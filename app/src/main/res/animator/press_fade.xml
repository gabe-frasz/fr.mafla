<?xml version="1.0" encoding="utf-8"?>
<!-- Touch feedback instead of the system ripple: the touched control dims while pressed -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <objectAnimator
            android:duration="@integer/motion_press"
            android:interpolator="@interpolator/standard"
            android:propertyName="alpha"
            android:valueTo="0.56"
            android:valueType="floatType" />
    </item>
    <item>
        <objectAnimator
            android:duration="@integer/motion_release"
            android:interpolator="@interpolator/standard"
            android:propertyName="alpha"
            android:valueTo="1"
            android:valueType="floatType" />
    </item>
</selector>
