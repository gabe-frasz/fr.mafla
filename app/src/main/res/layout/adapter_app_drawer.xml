<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/appTitle"
        style="@style/TextLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="@dimen/list_text_start"
        android:paddingEnd="48dp"
        android:paddingVertical="@dimen/app_padding_vertical"
        android:text="@string/app" />

    <!-- Section letter in the gutter, on the first app of each letter -->
    <TextView
        android:id="@+id/appLetter"
        style="@style/TextIndexLetter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="@dimen/screen_margin"
        android:importantForAccessibility="no"
        android:visibility="gone"
        tools:text="C"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/otherProfileIndicator"
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="50dp"
        android:layout_marginTop="1dp"
        android:gravity="center"
        android:src="@drawable/ic_rounded"
        app:tint="?attr/primaryColor" />

    <!-- Actions and rename rows are inflated on first long press, keeping every row light -->
    <ViewStub
        android:id="@+id/menuStub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inflatedId="@+id/appHideLayout"
        android:layout="@layout/adapter_app_drawer_menu" />

    <ViewStub
        android:id="@+id/renameStub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inflatedId="@+id/renameLayout"
        android:layout="@layout/adapter_app_drawer_rename" />

</FrameLayout>
