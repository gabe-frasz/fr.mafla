<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryShadeDarkColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="56dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin">

            <ImageView
                android:id="@+id/back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="-14dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:scaleType="center"
                android:src="@drawable/ic_back"
                app:tint="?attr/secondaryColor" />

            <EditText
                android:id="@+id/groupName"
                style="@style/TextScreenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@null"
                android:hint="@string/group_name"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textNoSuggestions"
                android:maxLength="30"
                android:maxLines="1"
                android:paddingVertical="0dp"
                android:paddingBottom="8dp"
                android:textColor="?attr/primaryColor"
                android:textColorHint="?attr/tertiaryColor" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/lineColor" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/selectedCount"
                    style="@style/TextCaption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/secondaryColor"
                    tools:text="7 selecionados" />

                <TextView
                    android:id="@+id/onlySelected"
                    style="@style/TextCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:text="@string/only_selected"
                    android:textColor="?attr/secondaryColor" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="?attr/secondaryColor" />

                <EditText
                    android:id="@+id/search"
                    style="@style/TextSmall"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_apps"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="textNoSuggestions"
                    android:maxLines="1"
                    android:textColor="?attr/primaryColor"
                    android:textColorHint="?attr/secondaryColor" />
            </LinearLayout>
        </LinearLayout>

        <fr.mafla.ui.widget.FadingEdgeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/appsList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="96dp"
                tools:listitem="@layout/item_group_app" />
        </fr.mafla.ui.widget.FadingEdgeLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/deleteGroup"
        style="@style/TextSmallBold"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginBottom="32dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:text="@string/delete_group"
        android:visibility="gone"
        tools:visibility="visible" />
</FrameLayout>
