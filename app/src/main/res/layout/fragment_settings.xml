<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainActivityLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryShadeDarkColor">

    <fr.mafla.ui.widget.FadingEdgeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/scrollLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="56dp"
            android:paddingBottom="48dp">

            <ImageView
                android:id="@+id/back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="-14dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:scaleType="center"
                android:src="@drawable/ic_back"
                app:tint="?attr/secondaryColor" />

            <TextView
                style="@style/TextScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings"
                android:textColor="?attr/primaryColor" />

            <TextView
                style="@style/TextSectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="8dp"
                android:text="@string/home_screen" />

            <LinearLayout
                android:id="@+id/homeAppsNumRow"
                style="@style/SettingsRow"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/apps_on_home_screen" />

                <TextView
                    android:id="@+id/homeAppsNum"
                    style="@style/SettingsValue"
                    tools:text="@string/_8" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dateTimeRow"
                style="@style/SettingsRow"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/show_date_time" />

                <TextView
                    android:id="@+id/dateTime"
                    style="@style/SettingsValue"
                    tools:text="@string/on" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/alignmentRow"
                style="@style/SettingsRow"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/home_layout_alignment" />

                <TextView
                    android:id="@+id/alignment"
                    style="@style/SettingsValue"
                    tools:text="@string/left" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/screenTimeLayout"
                style="@style/SettingsRow"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/screen_time" />

                <TextView
                    android:id="@+id/screenTimeOnOff"
                    style="@style/SettingsValue"
                    tools:text="@string/off" />
            </LinearLayout>

            <TextView
                style="@style/TextSectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="8dp"
                android:text="@string/app_list" />

            <LinearLayout
                android:id="@+id/groupsRow"
                style="@style/SettingsRow"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/groups" />

                <TextView
                    android:id="@+id/groupsCount"
                    style="@style/SettingsValue"
                    tools:text="4" />
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_end"
                    app:tint="?attr/secondaryColor" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/alphabetIndexRow"
                style="@style/SettingsRow"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/alphabet_index" />

                <TextView
                    android:id="@+id/alphabetIndex"
                    style="@style/SettingsValue"
                    tools:text="@string/on" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/autoShowKeyboardRow"
                style="@style/SettingsRow"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/auto_show_keyboard" />

                <TextView
                    android:id="@+id/autoShowKeyboard"
                    style="@style/SettingsValue"
                    tools:text="@string/on" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hiddenAppsRow"
                style="@style/SettingsRow"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/hidden_apps" />

                <TextView
                    android:id="@+id/maflaHiddenApps"
                    style="@style/SettingsValue"
                    tools:text="0" />
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_end"
                    app:tint="?attr/secondaryColor" />
            </LinearLayout>

            <TextView
                style="@style/TextSectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="8dp"
                android:text="@string/appearance" />

            <LinearLayout
                android:id="@+id/appThemeRow"
                style="@style/SettingsRow"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/theme_mode" />

                <TextView
                    android:id="@+id/appThemeText"
                    style="@style/SettingsValue"
                    tools:text="@string/dark" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/statusBarRow"
                style="@style/SettingsRow"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/notification_bar" />

                <TextView
                    android:id="@+id/statusBar"
                    style="@style/SettingsValue"
                    tools:text="@string/off" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/boldFontRow"
                style="@style/SettingsRow"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/bold_font" />

                <TextView
                    android:id="@+id/boldFont"
                    style="@style/SettingsValue"
                    tools:text="@string/off" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/textSizeRow"
                style="@style/SettingsRow"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/text_size" />

                <TextView
                    android:id="@+id/textSizeValue"
                    style="@style/SettingsValue"
                    tools:text="1.0" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/animationsRow"
                style="@style/SettingsRow"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/animations" />

                <TextView
                    android:id="@+id/animations"
                    style="@style/SettingsValue"
                    tools:text="@string/system_default" />
            </LinearLayout>

            <TextView
                style="@style/TextSectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="8dp"
                android:text="@string/gestures" />

            <LinearLayout
                android:id="@+id/swipeLeftRow"
                style="@style/SettingsRow"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/swipe_left_app" />

                <TextView
                    android:id="@+id/swipeLeftApp"
                    style="@style/SettingsValue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/swipeRightRow"
                style="@style/SettingsRow"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/swipe_right_app" />

                <TextView
                    android:id="@+id/swipeRightApp"
                    style="@style/SettingsValue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/toggleLockRow"
                style="@style/SettingsRow"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/double_tap_to_lock_screen" />

                <TextView
                    android:id="@+id/toggleLock"
                    style="@style/SettingsValue"
                    tools:text="@string/off" />
            </LinearLayout>

            <TextView
                style="@style/TextSectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="8dp"
                android:text="@string/app_name" />

            <TextView
                android:id="@+id/setLauncher"
                style="@style/SettingsLabel"
                android:layout_width="match_parent"
                android:layout_weight="0"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/settings_row_height"
                android:text="@string/set_as_default_launcher" />

            <TextView
                android:id="@+id/appInfo"
                style="@style/SettingsLabel"
                android:layout_width="match_parent"
                android:layout_weight="0"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/settings_row_height"
                android:text="@string/app_info" />

        </LinearLayout>

    </ScrollView>
    </fr.mafla.ui.widget.FadingEdgeLayout>

</FrameLayout>
