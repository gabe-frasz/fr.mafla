<?xml version="1.0" encoding="utf-8"?>
<!-- Home returning once the app list is mostly gone -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false"
    android:startOffset="@integer/motion_handoff">
    <alpha
        android:duration="300"
        android:fromAlpha="0"
        android:interpolator="@interpolator/standard_decelerate"
        android:toAlpha="1" />
    <translate
        android:duration="@integer/motion_enter"
        android:fromYDelta="-3%"
        android:interpolator="@interpolator/emphasized_decelerate"
        android:toYDelta="0" />
    <scale
        android:duration="@integer/motion_enter"
        android:fromXScale="0.97"
        android:fromYScale="0.97"
        android:interpolator="@interpolator/emphasized_decelerate"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1"
        android:toYScale="1" />
</set>
