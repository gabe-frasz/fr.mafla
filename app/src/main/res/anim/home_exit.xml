<?xml version="1.0" encoding="utf-8"?>
<!-- Home making room for the app list: lifts, shrinks slightly and fades -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="@integer/motion_exit"
    android:interpolator="@interpolator/emphasized_accelerate"
    android:shareInterpolator="true">
    <alpha
        android:fromAlpha="1"
        android:toAlpha="0" />
    <translate
        android:fromYDelta="0"
        android:toYDelta="-3%" />
    <scale
        android:fromXScale="1"
        android:fromYScale="1"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="0.98"
        android:toYScale="0.98" />
</set>
